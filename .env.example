[TEMPLATE]
# SquadUp environment variables
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore + AGENTS.md rule 9).

# PocketBase (frontend client — lib/api/client.ts)
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090

# OTP email delivery (Flow 1 — college email verification)
# Pick one provider; Resend is the simplest for a student project.
RESEND_API_KEY=
OTP_FROM_EMAIL=SquadUp <noreply@squadup.example>

# Allowed signup domain (Flow 1 — domain-restricted signup; pb_hooks/domain.js)
ALLOWED_SIGNUP_DOMAIN=college.edu

# OTP allowlist — comma-separated exact emails that may receive a login code
# even outside the college domain (demo-day / mentor accounts). Read by the
# onMailerRecordOTPSend gate in pb_hooks/main.pb.js.
SQUADUP_OTP_ALLOWLIST=

# GitHub integration (Feature 4B — commit graph + activity score)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
