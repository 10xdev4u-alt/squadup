# SquadUp environment variables
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore + AGENTS.md rule 9).

# PocketBase
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# OTP email delivery (Flow 1 — college email verification)
# Pick one provider; Resend is the simplest for a student project.
RESEND_API_KEY=
OTP_FROM_EMAIL=SquadUp <noreply@squadup.example>

# Allowed signup domain (Flow 1 — domain-restricted signup)
ALLOWED_SIGNUP_DOMAIN=college.edu

# GitHub integration (Feature 4B — commit graph + activity score)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
