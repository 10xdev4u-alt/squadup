# SquadUp environment variables
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore + AGENTS.md rule 9).
#
# Groups: 1) Frontend (read at build/runtime on Vercel)
#         2) PocketBase server (read from the PB process env)
#         3) Future integrations (not read yet — see the deployment runbook)

# ──────────────────────────────────────────────────────────────
# 1) FRONTEND — Vercel (or local `next dev`/`next build`)
# ──────────────────────────────────────────────────────────────

# PocketBase base URL the browser client talks to (lib/api/client.ts).
# Public by design — PB enforces auth server-side, this is just the endpoint.
NEXT_PUBLIC_PB_URL=https://pb.squadup.example

# ──────────────────────────────────────────────────────────────
# 2) POCKETBASE SERVER — process env of the PB binary (pb serve)
# ──────────────────────────────────────────────────────────────

# College email domains allowed to sign up (pb_hooks/main.pb.js).
# Comma-separated. Falls back to "college.edu" when unset.
ALLOWED_SIGNUP_DOMAIN=svce.ac.in

# Comma-separated exact emails that may receive a login code even outside
# the college domain (demo-day / mentor / judge accounts). Read by the
# onMailerRecordOTPSend gate in pb_hooks/main.pb.js. Empty = nobody.
SQUADUP_OTP_ALLOWLIST=

# OTP email delivery — configured in PB admin (Settings → Mail), not env:
#   Mail → Resend:  SMTP host smtp.resend.com, port 587, TLS, user resend,
#                   password <RESEND_API_KEY>
#   From address:   SquadUp <noreply@squadup.example>
# (Resend keys live in the PB admin settings UI, never in this file.)

# ──────────────────────────────────────────────────────────────
# 3) FUTURE INTEGRATIONS — not read by any code yet
# ──────────────────────────────────────────────────────────────

# GitHub integration (Feature 4B — commit graph + activity score).
# Reserved for the OAuth app; see docs/DEPLOYMENT.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
